<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="nexora"
        Arguments=""
        InstallLocation="C:\Program Files\Diwanshu Midha\Nexora">
    </Installer>
    <PackageInformation
        PackageName="Nexora"
        PackageDisplayName="Nexora"
        PublisherName="CN=Diwanshu Midha"
        PublisherDisplayName="Diwanshu Midha"
        Version="0.1.0.0"
        PackageDescription="Connect AI assistants to your computer">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.codedecoders.nexora"
                Description="Connect AI assistants to your computer"
                DisplayName="Nexora"
                ExecutableName="nexora"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Nexora</DisplayName>
            <PublisherDisplayName>Diwanshu Midha</PublisherDisplayName>
            <Description>Connect AI assistants to your computer</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="nexora.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
